# RapidAPI key for the Anna's Archive API (required)
RAPIDAPI_KEY=
RAPIDAPI_HOST=annas-archive-api.p.rapidapi.com

# Your personal Send-to-Kindle address (e.g. yourname@kindle.com)
KINDLE_EMAIL=

# Approved sender email + Gmail SMTP credentials (use a Gmail App Password)
SENDER_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Where downloaded EPUBs are stored
LIBRARY_DIR=./library

# Directory for the SQLite database (kindlebooks.db). Defaults to the project
# root locally. On Fly.io this is set to the mounted volume (/data).
# DATA_DIR=/data

# Optional: NYT Books API key to show bestseller shelves on the homepage.
# Get a free key at https://developer.nytimes.com (leave blank to skip).
NYT_API_KEY=
NEXT_PUBLIC_SITE_URL=https://books.ritavdas.com
